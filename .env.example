# PKI Issuing Certificate Authority System - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# NEVER commit the actual .env file or real secrets to version control.

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pki_ca_db
DB_USER=pki_app_user
DB_PASSWORD=ChangeMeLocalDbPassword123!
DB_ROOT_PASSWORD=ChangeMeLocalDbRootPassword123!

# Application Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security Secrets (Must be at least 256 bits / 32 characters for HMAC-SHA256)
JWT_SECRET=YourSuperSecretKeyMustBeAtLeast32BytesLongForHmacSha256Security123456
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=28800000

# Audit Hash Chaining HMAC Secret
AUDIT_HMAC_SECRET=AnotherSuperSecretKeyForAuditHashChainingMustBeAtLeast32Bytes123456

# Initial Bootstrap Administrator Setup
# Used ONLY on clean initial installation to provision the primary CA Administrator.
# Once provisioned, changes should be managed through standard admin endpoints.
BOOTSTRAP_ADMIN_USERNAME=ca_admin
BOOTSTRAP_ADMIN_EMAIL=ca-admin@pki.internal.corp
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdminInitialPassword123!
BOOTSTRAP_ADMIN_FULL_NAME="PKI System Administrator"

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
